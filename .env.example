# Postgres (Neon). Required.
DATABASE_URL=
# better-auth. Required in production; generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. https://demo.example.com (falls back to VERCEL_* URLs).
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=
# Vercel Blob private store (documents and obligation evidence).
BLOB_READ_WRITE_TOKEN=
# Vercel AI Gateway, used by /api/compi (model google/gemini-2.5-flash). Not needed on Vercel with OIDC.
AI_GATEWAY_API_KEY=

# Demo environment
# Public sign-up at /api/auth/sign-up stays closed unless this is exactly "true".
ALLOW_SIGNUP=false
# Shows the "Demo con datos ficticios" banner and sends noindex unless this is exactly "false".
DEMO_MODE=true

BLOB_STORE_ID=

# Claude Haiku para categorizar fuentes en /admin/ingesta (https://console.anthropic.com).
ANTHROPIC_API_KEY=
